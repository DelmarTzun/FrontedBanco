# Configuración aplicada en `npm run build` (producción / Azure Static Web Apps).
# Vite la fusiona ENCIMA de .env, así que aquí basta con sobreescribir lo que cambia.
#
# En producción el frontend vive en un dominio distinto del backend, así que
# NO podemos usar el proxy del dev server. Apuntamos directo a la API del banco.

VITE_API_BASE_URL=https://bancocentroamericano.azurewebsites.net/api
VITE_USE_PROXY=false
VITE_APP_NAME=Cosmos Bank
