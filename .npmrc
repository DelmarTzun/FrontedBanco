# Instala automáticamente las peer dependencies (default desde pnpm 8)
auto-install-peers=true

# Permite que paquetes con peer deps mixtas se resuelvan sin warnings
strict-peer-dependencies=false

# Forzar el uso de pnpm en este proyecto (engine declarado en package.json)
engine-strict=true

# Nota: en pnpm 11+, las opciones onlyBuiltDependencies y verifyDepsBeforeRun
# se configuran en pnpm-workspace.yaml (este .npmrc ya no las acepta).
