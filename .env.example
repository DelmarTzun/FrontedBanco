# URL base de la API del banco
# Producción (Azure): https://bancocentroamericano.azurewebsites.net/api
# Local (.NET):       https://localhost:7160/api
VITE_API_BASE_URL=https://bancocentroamericano.azurewebsites.net/api

# Nombre visible de la marca
VITE_APP_NAME=Cosmos Bank

# Si "true", el dev server proxea /api hacia VITE_API_BASE_URL
# (evita problemas de CORS al desarrollar contra un backend remoto)
VITE_USE_PROXY=false
